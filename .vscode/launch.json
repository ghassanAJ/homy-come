    "version": "0.2.0",
    "configurations": [
        {
            "name": "User App",
            "request": "launch",
            "type": "dart",
            "program": "apps/user/lib/main.dart",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/env/config.dev.json"
            ]

        },
        {
            "name": "Driver App",
            "request": "launch",
            "type": "dart",
            "program": "apps/driver/lib/main.dart",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/env/config.dev.json"
            ]
        },
        {
            "name": "Provider App",
            "request": "launch",
            "type": "dart",
            "program": "apps/provider/lib/main.dart",
            "toolArgs": [
                "--dart-define-from-file=${workspaceFolder}/env/config.dev.json"
            ]
        },
       
    ]
}